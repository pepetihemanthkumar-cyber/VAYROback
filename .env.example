# ========================================================
# VAYRO Microservices Backend Environment Configuration
# ========================================================

# Server Ports
# Eureka Server: 8761
# API Gateway: 8080
# User Service: 8081
# Vehicle Service: 8082
# Booking Service: 8083
# Notification Service: 8084

# Service Discovery
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# ========================================================
# Supabase PostgreSQL Session Pooler Configuration
# ========================================================
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.lgpuulmsdogxzsyoqwdk
DB_PASSWORD=your_secure_database_password_here

# ========================================================
# Security & JWT Authentication (256-bit Base64 / Hex Key)
# ========================================================
JWT_SECRET=your_256_bit_base64_jwt_secret_here

# ========================================================
# Google OAuth 2.0 Backend Configuration
# ========================================================
GOOGLE_CLIENT_ID=718836314167-kekvffi6ugr8s6gfg6ds00qb190ee12s.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ========================================================
# CORS Configuration
# ========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://vayro.com

# ========================================================
# Notification Service (Gmail SMTP)
# ========================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=vayro.notifications@gmail.com
# MAIL_PASSWORD=your_16_character_google_app_password_here
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=true
# MAIL_FROM_NAME=VAYRO
# MAIL_FROM_ADDRESS=vayro.notifications@gmail.com
# NOTIFICATION_EMAIL_ENABLED=false
# ADMIN_NOTIFICATION_EMAIL=admin@vayro.com

# ========================================================
# Admin Bootstrap Configuration (Disabled by default in production)
# ========================================================
ADMIN_BOOTSTRAP_ENABLED=false
# ADMIN_EMAIL=admin@vayro.com
# ADMIN_PASSWORD=your_secure_admin_password_here
